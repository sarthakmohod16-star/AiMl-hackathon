# BizTwin Backend Configuration
# Copy this file to .env and customize as needed.

APP_NAME="BizTwin API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api"

# Database Configuration (SQLite development file)
DATABASE_URL="sqlite:///./biztwin.db"

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Default Currency
DEFAULT_CURRENCY="INR"

# Location Intelligence Providers (OpenStreetMap)
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
OVERPASS_BASE_URL="https://overpass-api.de/api/interpreter"
OSM_USER_AGENT="BizTwin-Hackathon/0.1.0 (contact@biztwin.local)"
LOCATION_REQUEST_TIMEOUT_SECONDS=8.0
